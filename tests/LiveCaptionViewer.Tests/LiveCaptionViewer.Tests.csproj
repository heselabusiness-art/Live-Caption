<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the pure-logic parts of the app. The sources are linked (not referenced) from the
    WPF project so the tests are plain net10.0 and run on any OS, including Linux CI runners.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>LiveCaptionViewer.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Services\SegmentCaptureTracker.cs" Link="Linked\SegmentCaptureTracker.cs" />
    <Compile Include="..\..\Services\PromptBuilder.cs" Link="Linked\PromptBuilder.cs" />
    <Compile Include="..\..\Services\SelectorOverrides.cs" Link="Linked\SelectorOverrides.cs" />
    <Compile Include="..\..\Services\PreInterviewIngestionPipeline.cs" Link="Linked\PreInterviewIngestionPipeline.cs" />
    <Compile Include="..\..\Models\ProxySettings.cs" Link="Linked\ProxySettings.cs" />
    <Compile Include="..\..\Models\PreInterviewFormContext.cs" Link="Linked\PreInterviewFormContext.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
