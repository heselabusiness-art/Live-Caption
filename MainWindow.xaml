<Window x:Class="LiveCaptionViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Live Caption Viewer"
        Icon="Assets/AppIcon.ico"
        Height="780" Width="1320"
        MinHeight="500" MinWidth="900"
        Background="Transparent"
        FontFamily="Segoe UI"
        Topmost="True"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1177BB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact toolbar buttons for the browser nav row. -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- Dark-themed TextBox for multi-line inputs (Resume Builder). -->
        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Background"                  Value="#1E1E1E"/>
            <Setter Property="Foreground"                  Value="#EAEAEA"/>
            <Setter Property="BorderBrush"                 Value="#3F3F46"/>
            <Setter Property="BorderThickness"             Value="1"/>
            <Setter Property="Padding"                     Value="8"/>
            <Setter Property="FontSize"                    Value="13"/>
            <Setter Property="FontFamily"                  Value="Consolas, Segoe UI"/>
            <Setter Property="TextWrapping"                Value="Wrap"/>
            <Setter Property="AcceptsReturn"               Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="CaretBrush"                  Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Padding="{TemplateBinding Padding}"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                                <!-- Watermark: shown only when Tag is set and Text is empty -->
                                <TextBlock x:Name="Hint"
                                           Padding="{TemplateBinding Padding}"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#505050"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontStyle="Italic"
                                           IsHitTestVisible="False"
                                           TextWrapping="{TemplateBinding TextWrapping}"
                                           VerticalAlignment="Top"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab bar header strip (wraps the TabPanel). -->
        <Style x:Key="DarkTabControl" TargetType="TabControl">
            <Setter Property="Background"      Value="#252526"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Header strip -->
                            <Border Grid.Row="0"
                                    Background="#2D2D30"
                                    CornerRadius="6,6,0,0">
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                            </Border>
                            <!-- Content area -->
                            <Border Grid.Row="1"
                                    Background="#252526"
                                    CornerRadius="0,0,6,6"
                                    ClipToBounds="True">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Individual tab header button. -->
        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground"   Value="#9A9A9A"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="18,8"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Background="Transparent">
                            <TextBlock Text="{TemplateBinding Header}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0E639C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS-style toggle switch for the Auto-send feature. -->
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width"  Value="46"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!-- Track -->
                            <Border x:Name="Track"
                                    CornerRadius="12"
                                    Background="#555555"/>
                            <!-- Thumb — left/right position controlled via Margin -->
                            <Border x:Name="Thumb"
                                    Width="18" Height="18"
                                    CornerRadius="9"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0E639C"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="25,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Pre-interview field label style -->
        <Style x:Key="PiLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#9A9A9A"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,3"/>
        </Style>

        <!-- Pre-interview group header -->
        <Style x:Key="PiGroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#569CD6"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,8"/>
        </Style>

        <Style x:Key="PiHint" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#7A7A7A"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"      Value="0,0,0,8"/>
        </Style>

        <!-- Interview-round radio button pill style -->
        <Style x:Key="RoundPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0E639C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1177BB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root shell: gives the window a rounded dark background with adjustable opacity -->
    <Border x:Name="AppShell"
            Background="#1E1E1E"
            CornerRadius="8"
            BorderBrush="#3F3F46"
            BorderThickness="1">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar — drag to move, buttons to minimize/close -->
        <Grid Grid.Row="0"
              x:Name="TitleBar"
              MouseDown="TitleBar_MouseDown">
        <DockPanel Margin="0,0,0,12" LastChildFill="False">

            <!-- Title block -->
            <StackPanel DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/AppIcon.ico"
                           Width="22" Height="22"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Live Caption Viewer"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Embedded browser + Windows 11 Live Captions reader"
                           Foreground="#9A9A9A"
                           FontSize="12"
                           Margin="30,2,0,0"/>
            </StackPanel>

            <!-- Window control buttons + Opacity slider (right side) -->
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="0,0,0,0">

                <!-- Opacity control -->
                <TextBlock Text="Opacity"
                           Foreground="#9A9A9A"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <Slider x:Name="OpacitySlider"
                        Width="120"
                        Minimum="0.05"
                        Maximum="1"
                        Value="1"
                        SmallChange="0.05"
                        LargeChange="0.1"
                        TickFrequency="0.05"
                        VerticalAlignment="Center"
                        ToolTip="Adjust window transparency (5% – 100%)"
                        ValueChanged="OpacitySlider_ValueChanged"/>
                <TextBlock x:Name="OpacityLabel"
                           Text="100%"
                           Foreground="#9A9A9A"
                           FontSize="12"
                           Width="36"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="6,0,12,0"/>

                <!-- Click-through toggle -->
                <Button x:Name="ClickThroughButton"
                        Content="🖱 Pass"
                        Width="64" Height="28"
                        FontSize="11"
                        Background="Transparent"
                        Foreground="#9A9A9A"
                        BorderThickness="1"
                        BorderBrush="#555555"
                        ToolTip="Click-Through OFF — clicks land on this app (Ctrl+W to toggle)"
                        Click="ClickThroughButton_Click"
                        Margin="0,0,8,0"/>

                <!-- Minimize -->
                <Button Width="28" Height="28"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Minimize"
                        Click="MinimizeButton_Click"
                        Margin="0,0,4,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="&#xE921;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="#9A9A9A"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Button>

                <!-- Close -->
                <Button Width="28" Height="28"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Close"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#99E81123"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#CCE81123"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="&#xE8BB;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="#9A9A9A"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>

        </DockPanel>
        </Grid>

        <!-- Main content: browser (left) | splitter | captions panel (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="380"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="1*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- ============== BROWSER COLUMN ============== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Browser toolbar -->
                <Border Grid.Row="0"
                        Background="#2D2D30"
                        CornerRadius="6"
                        Padding="8"
                        Margin="0,0,0,8">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="BackButton"
                                DockPanel.Dock="Left"
                                Content="←"
                                Style="{StaticResource ToolbarButton}"
                                ToolTip="Back"
                                Click="BackButton_Click"/>
                        <Button x:Name="ForwardButton"
                                DockPanel.Dock="Left"
                                Content="→"
                                Style="{StaticResource ToolbarButton}"
                                ToolTip="Forward"
                                Click="ForwardButton_Click"/>
                        <Button x:Name="RefreshButton"
                                DockPanel.Dock="Left"
                                Content="⟳"
                                Style="{StaticResource ToolbarButton}"
                                ToolTip="Refresh"
                                Margin="0,0,8,0"
                                Click="RefreshButton_Click"/>
                        <!-- Bookmark buttons (right side, before Go) -->
                        <Button x:Name="BookmarkClaudeButton"
                                DockPanel.Dock="Right"
                                Content="Claude"
                                Width="58" Height="30"
                                Margin="4,0,0,0"
                                ToolTip="Navigate to Claude (claude.ai)"
                                Click="BookmarkClaude_Click"/>
                        <Button x:Name="BookmarkGptButton"
                                DockPanel.Dock="Right"
                                Content="ChatGPT"
                                Width="64" Height="30"
                                Margin="4,0,0,0"
                                ToolTip="Navigate to ChatGPT (chatgpt.com)"
                                Click="BookmarkGpt_Click"/>
                        <Button x:Name="GoButton"
                                DockPanel.Dock="Right"
                                Content="Go"
                                Width="56" Height="30"
                                Margin="8,0,0,0"
                                Click="GoButton_Click"/>
                        <TextBox x:Name="AddressBar"
                                 Height="30"
                                 Padding="8,5"
                                 VerticalContentAlignment="Center"
                                 Background="#1E1E1E"
                                 Foreground="#EAEAEA"
                                 BorderBrush="#3F3F46"
                                 BorderThickness="1"
                                 FontSize="13"
                                 KeyDown="AddressBar_KeyDown"/>
                    </DockPanel>
                </Border>

                <!-- Live caption bar -->
                <Border Grid.Row="1"
                        Background="#12121C"
                        BorderBrush="#2A2A3A"
                        BorderThickness="0,1,0,1"
                        Padding="10,5"
                        Margin="0,0,0,6">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="🎙"
                                   FontSize="11"
                                   Foreground="#556677"
                                   VerticalAlignment="Top"
                                   Margin="0,1,6,0"/>
                        <ScrollViewer x:Name="LiveCaptionScroll"
                                      MaxHeight="72"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="LiveCaptionLabel"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- WebView2 surface -->
                <Border Grid.Row="2"
                        Background="#252526"
                        CornerRadius="6"
                        Padding="2">
                    <Grid>
                        <Grid x:Name="BrowserHost">
                            <wv2:WebView2 x:Name="Browser"/>
                        </Grid>
                        <TextBlock x:Name="BrowserOverlay"
                                   Visibility="Collapsed"
                                   Text="WebView2 unavailable."
                                   Foreground="#FF6B6B"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Padding="24"
                                   TextAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Resize splitter -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#1E1E1E"
                          ShowsPreview="True"/>

            <!-- ============== CAPTIONS COLUMN ============== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>              <!-- 0: capture status  -->
                    <RowDefinition Height="Auto"/>              <!-- 1: interview round -->
                    <RowDefinition Height="*" MinHeight="80"/>  <!-- 2: tab panel       -->
                    <RowDefinition Height="Auto"/>              <!-- 3: send status     -->
                    <RowDefinition Height="Auto"/>              <!-- 4: controls        -->
                </Grid.RowDefinitions>

                <!-- Capture status bar -->
                <Border Grid.Row="0"
                        Background="#2D2D30"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusIndicator"
                                 Width="12" Height="12"
                                 Fill="Gray"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>
                        <TextBlock x:Name="StatusLabel"
                                   Text="Idle"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- ── Interview round selector ────────────────────────────── -->
                <Border Grid.Row="1"
                        Background="#252526"
                        BorderBrush="#3F3F46"
                        BorderThickness="0,0,0,1"
                        Padding="8,6"
                        Margin="0,0,0,0">
                    <WrapPanel Orientation="Horizontal" x:Name="RoundPanel">
                        <RadioButton x:Name="RoundRecruiter"
                                     Content="Recruiter Screen"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     IsChecked="True"
                                     Margin="0,0,6,0"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundHiringManager"
                                     Content="Hiring Manager"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Margin="0,0,6,0"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundTechnical"
                                     Content="Technical Screen"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Margin="0,0,6,0"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundSystemDesign"
                                     Content="System Design"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Margin="0,0,6,0"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundMlSystemDesign"
                                     Content="ML System Design"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Margin="0,0,6,0"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundBehavioral"
                                     Content="Behavioral"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Margin="0,0,6,0"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundCultureFit"
                                     Content="Culture Fit"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Margin="0,0,6,0"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundPeer"
                                     Content="Peer"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Margin="0,0,6,0"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundBarRaiser"
                                     Content="Bar Raiser"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Margin="0,0,6,0"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundSkipLevel"
                                     Content="Skip Level"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Margin="0,0,6,0"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundExecutive"
                                     Content="Executive/VP"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Margin="0,0,6,0"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundFinal"
                                     Content="Final"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Margin="0,0,6,0"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundPresentation"
                                     Content="Presentation"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Margin="0,0,6,0"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundCaseStudy"
                                     Content="Case Study"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Margin="0,0,6,0"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundResearch"
                                     Content="Research"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Margin="0,0,6,0"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundCode"
                                     Content="Code"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Margin="0,0,6,0"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundDiagram"
                                     Content="Diagram"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                    </WrapPanel>
                </Border>

                <!-- ── Tab panel ───────────────────────────────────────────── -->
                <TabControl x:Name="CaptionTabControl"
                            Grid.Row="2"
                            Style="{StaticResource DarkTabControl}">

                    <!-- ══ SEGMENT tab ══ -->
                    <TabItem Header="Behavioral &amp; Intro"
                             Style="{StaticResource DarkTabItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Segment sub-header (indicator + label) -->
                            <Border Grid.Row="0"
                                    Style="{StaticResource SectionHeader}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <Ellipse x:Name="RecordingIndicator"
                                                 Width="10" Height="10"
                                                 Fill="Gray"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="SEGMENT"
                                                   Foreground="#EAEAEA"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RecordingLabel"
                                                   Text=" — Auto-send OFF — capture only; segment not sent (PageUp toggles)."
                                                   Foreground="#9A9A9A"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="PageUp = toggle Auto-send · Home/End capture (send when ON)"
                                               Foreground="#666"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1"
                                          x:Name="RecordedScroll"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="RecordedBox"
                                         Background="Transparent"
                                         Foreground="#EAEAEA"
                                         BorderThickness="0"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         FontSize="14"
                                         FontFamily="Consolas, Segoe UI"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Disabled"
                                         Padding="12"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ══ Tech Interview tab ══ -->
                    <TabItem Header="Tech Interview"
                             Style="{StaticResource DarkTabItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>                    <!-- 0: SEGMENT sub-header -->
                                <RowDefinition Height="*" MinHeight="70"/>        <!-- 1: SEGMENT text       -->
                                <RowDefinition Height="Auto"/>                    <!-- 2: browser picker     -->
                                <RowDefinition Height="Auto"/>                    <!-- 3: tech status        -->
                                <RowDefinition Height="2.2*" MinHeight="140"/>    <!-- 4: screenshot         -->
                            </Grid.RowDefinitions>

                            <!-- ── SEGMENT sub-header (mirror of SEGMENT tab) ── -->
                            <Border Grid.Row="0"
                                    Style="{StaticResource SectionHeader}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <Ellipse x:Name="TiSegmentIndicator"
                                                 Width="10" Height="10"
                                                 Fill="Gray"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="SEGMENT"
                                                   Foreground="#EAEAEA"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TiSegmentLabel"
                                                   Text=" — Auto-send OFF — capture only; segment not sent (PageUp toggles)."
                                                   Foreground="#9A9A9A"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="PageUp = toggle · Home/End/Delete capture (send when ON) · Insert capture"
                                               Foreground="#666"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- ── SEGMENT text (mirror of SEGMENT tab) ── -->
                            <ScrollViewer Grid.Row="1"
                                          x:Name="TiSegmentScroll"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="TiSegmentBox"
                                         Background="Transparent"
                                         Foreground="#EAEAEA"
                                         BorderThickness="0"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         FontSize="13"
                                         FontFamily="Consolas, Segoe UI"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Disabled"
                                         Padding="12,8"/>
                            </ScrollViewer>

                            <!-- ── Browser picker ── -->
                            <Border Grid.Row="2"
                                    Background="#1E1E1E"
                                    BorderBrush="#3F3F46"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,6"
                                    Margin="12,8,12,8">
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="RefreshBrowsersButton"
                                            DockPanel.Dock="Left"
                                            Content="Refresh"
                                            Width="74" Height="26"
                                            Padding="6,3"
                                            FontSize="11"
                                            Click="RefreshBrowsers_Click"/>
                                    <Button x:Name="CaptureBrowserButton"
                                            DockPanel.Dock="Right"
                                            Content="Capture"
                                            Width="100" Height="26"
                                            Padding="6,3"
                                            FontSize="11"
                                            IsEnabled="False"
                                            Margin="6,0,0,0"
                                            ToolTip="Capture selected window (global hotkey: Insert)"
                                            Click="CaptureBrowser_Click"/>
                                    <ComboBox x:Name="BrowserComboBox"
                                              Margin="8,0"
                                              VerticalAlignment="Center"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="BrowserComboBox_SelectionChanged"/>
                                </DockPanel>
                            </Border>

                            <!-- ── Tech-Interview-specific status line ── -->
                            <TextBlock x:Name="TechInterviewStatusLabel"
                                       Grid.Row="3"
                                       Text="Click Refresh to list all windows. Select one, then click Capture (or press Insert)."
                                       Foreground="#9A9A9A"
                                       FontSize="11"
                                       Margin="14,0,14,6"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- ── Captured screenshot ── -->
                            <Border Grid.Row="4"
                                    Background="#0A0A0A"
                                    BorderBrush="#3F3F46"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="12,0,12,12">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <Image x:Name="CapturedScreenshotImage"
                                           Stretch="None"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ══ Pre-interview tab ══ -->
                    <TabItem Header="Pre-interview"
                             Style="{StaticResource DarkTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,10,12,16">

                                <!-- ══ Ingestion pipeline ══════════════════════════════ -->
                                <Border Background="#1C2333" CornerRadius="4"
                                        Padding="10,8,10,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Ingestion Pipeline"
                                                   Style="{StaticResource PiGroupHeader}"/>
                                        <TextBlock Style="{StaticResource PiHint}"
                                                   Text="Fill “Your inputs” below, tick the steps you want, then press Start. Steps run one after another and report progress here; you confirm each result before it is applied. Steps missing their inputs are skipped."/>

                                        <ProgressBar x:Name="PiIngestOverallProgress"
                                                     Height="4"
                                                     Minimum="0" Maximum="1" Value="0"
                                                     Margin="0,0,0,10"
                                                     BorderThickness="0"
                                                     Foreground="#569CD6"
                                                     Background="#2A3142"/>

                                        <!-- Progress stepper (rows are data-bound; not buttons) -->
                                        <ItemsControl x:Name="PiIngestSteps"
                                                      Margin="0,0,0,6"
                                                      Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanEdit}"
                                                                  VerticalAlignment="Top"
                                                                  Margin="0,3,8,0"
                                                                  ToolTip="Include this step in the run"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Glyph}"
                                                                   Foreground="{Binding GlyphBrush}"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Top"
                                                                   Margin="0,1,0,0"/>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="#D4D4D4"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Detail}"
                                                                       Foreground="{Binding DetailBrush}"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"/>
                                                            <ProgressBar IsIndeterminate="True"
                                                                         Height="2"
                                                                         Margin="0,4,0,0"
                                                                         BorderThickness="0"
                                                                         Foreground="#DCDCAA"
                                                                         Background="#2A3142"
                                                                         Visibility="{Binding RunningVisibility}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button x:Name="PiIngestStartButton"
                                                Content="▶  Start ingestion"
                                                Height="32"
                                                Margin="0,0,0,8"
                                                Click="PiIngestStartButton_Click"/>

                                        <TextBlock x:Name="PiIngestStatusLabel"
                                                   Text=""
                                                   Foreground="#9A9A9A"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- ══ Your inputs (manual — before ingest) ════════════ -->
                                <Border Background="#1C2333" CornerRadius="4"
                                        Padding="10,8,10,10" Margin="0,0,0,10"
                                        BorderBrush="#2D4A3E" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Your inputs"
                                                   Style="{StaticResource PiGroupHeader}"/>
                                        <TextBlock Style="{StaticResource PiHint}"
                                                   Text="Resume + JD drive steps 2–4. Company + role context drive step 1. You can run any step when its minimum fields are filled."/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource PiLabel}">
                                                    <Run Text="RESUME SUMMARY"/>
                                                    <Run Text="  · required for 2–4" Foreground="#6A8F7A" FontWeight="Normal"/>
                                                </TextBlock>
                                                <TextBox x:Name="PiResumeSummary"
                                                         Style="{StaticResource DarkInput}"
                                                         Tag="Paste resume bullets — used for JD analysis, project, and system design ingests"
                                                         Height="110"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource PiLabel}">
                                                    <Run Text="JOB DESCRIPTION"/>
                                                    <Run Text="  · required for 2–4 · recommended for 1" Foreground="#6A8F7A" FontWeight="Normal"/>
                                                </TextBlock>
                                                <TextBox x:Name="PiJobDescription"
                                                         Style="{StaticResource DarkInput}"
                                                         Tag="Paste JD — shared across ingests"
                                                         Height="110"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource PiLabel}">
                                                    <Run Text="COMPANY"/>
                                                    <Run Text="  · required for 1" Foreground="#6A8F7A" FontWeight="Normal"/>
                                                </TextBlock>
                                                <TextBox x:Name="PiCompany"
                                                         Style="{StaticResource DarkInput}"
                                                         Tag="Company name"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource PiLabel}">
                                                    <Run Text="SENIORITY"/>
                                                    <Run Text="  · for 1" Foreground="#6A8F7A" FontWeight="Normal"/>
                                                </TextBlock>
                                                <TextBox x:Name="PiSeniority"
                                                         Style="{StaticResource DarkInput}"
                                                         Text="Staff"
                                                         Tag="Staff"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Style="{StaticResource PiLabel}">
                                                    <Run Text="DOMAIN"/>
                                                    <Run Text="  · for 1" Foreground="#6A8F7A" FontWeight="Normal"/>
                                                </TextBlock>
                                                <TextBox x:Name="PiDomain"
                                                         Style="{StaticResource DarkInput}"
                                                         Text="AI/ML"
                                                         Tag="AI/ML"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="COMPANY STAGE" Style="{StaticResource PiLabel}"/>
                                                <TextBox x:Name="PiCompanyStage"
                                                         Style="{StaticResource DarkInput}"
                                                         Tag="Filled by ingest or type manually"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Style="{StaticResource PiLabel}">
                                            <Run Text="INTERVIEWER BACKGROUND"/>
                                            <Run Text="  · optional for 1" Foreground="#6A8F7A" FontWeight="Normal"/>
                                        </TextBlock>
                                        <TextBox x:Name="PiInterviewerBackground"
                                                 Style="{StaticResource DarkInput}"
                                                 Tag="LinkedIn / calendar names — optional for company research"
                                                 Height="32"
                                                 AcceptsReturn="False"
                                                 TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Hidden"/>
                                    </StackPanel>
                                </Border>

                                <!-- ══ Step 1 output — Company Research ════════════════ -->
                                <Border Background="#1C2333" CornerRadius="4"
                                        Padding="10,8,10,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PiGroupHeader}">
                                            <Run Text="After step 1 — Company context"/>
                                            <Run Text="  (ingest or edit)" Foreground="#7A7A7A" FontWeight="Normal"/>
                                        </TextBlock>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Product" Style="{StaticResource PiLabel}"/>
                                                <TextBox x:Name="PiProduct"
                                                         Style="{StaticResource DarkInput}"
                                                         Tag="what they build in 1 sentence"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Team Focus" Style="{StaticResource PiLabel}"/>
                                                <TextBox x:Name="PiTeamFocus"
                                                         Style="{StaticResource DarkInput}"
                                                         Tag="what this specific team works on"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Known Tech Stack" Style="{StaticResource PiLabel}"/>
                                        <TextBox x:Name="PiKnownTechStack"
                                                 Style="{StaticResource DarkInput}"
                                                 Tag="from JD or research"
                                                 Height="50"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="Company Values" Style="{StaticResource PiLabel}"/>
                                        <TextBox x:Name="PiCompanyValues"
                                                 Style="{StaticResource DarkInput}"
                                                 Tag="from careers page or Glassdoor"
                                                 Height="50"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="Recent News" Style="{StaticResource PiLabel}"/>
                                        <TextBox x:Name="PiRecentNews"
                                                 Style="{StaticResource DarkInput}"
                                                 Tag="funding, product launch, or strategic shift"
                                                 Height="50"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="Typical Candidate Profile" Style="{StaticResource PiLabel}"/>
                                        <TextBox x:Name="PiTypicalCandidateProfile"
                                                 Style="{StaticResource DarkInput}"
                                                 Tag="What a typical hire looks like for this role"
                                                 Height="60"/>
                                    </StackPanel>
                                </Border>

                                <!-- ══ Step 2 output — JD Analysis ═════════════════════ -->
                                <Border Background="#1C2333" CornerRadius="4"
                                        Padding="10,8,10,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PiGroupHeader}">
                                            <Run Text="After step 2 — JD analysis"/>
                                            <Run Text="  (ingest or edit)" Foreground="#7A7A7A" FontWeight="Normal"/>
                                        </TextBlock>
                                        <TextBlock Text="Key Skills Detected" Style="{StaticResource PiLabel}"/>
                                        <TextBox x:Name="PiKeySkillsDetected"
                                                 Style="{StaticResource DarkInput}"
                                                 Tag="top 5 from resume"
                                                 Height="50"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="Key Projects Detected" Style="{StaticResource PiLabel}"/>
                                        <TextBox x:Name="PiKeyProjectsDetected"
                                                 Style="{StaticResource DarkInput}"
                                                 Tag="project names"
                                                 Height="50"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="JD Focus Areas Detected" Style="{StaticResource PiLabel}"/>
                                        <TextBox x:Name="PiJdFocusAreasDetected"
                                                 Style="{StaticResource DarkInput}"
                                                 Tag="top 3 requirements"
                                                 Height="50"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="My Differentiation" Style="{StaticResource PiLabel}"/>
                                        <TextBox x:Name="PiMyDifferentiation"
                                                 Style="{StaticResource DarkInput}"
                                                 Tag="What makes you better than the typical profile"
                                                 Height="60"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="My Through-Line" Style="{StaticResource PiLabel}"/>
                                        <TextBox x:Name="PiMyThroughLine"
                                                 Style="{StaticResource DarkInput}"
                                                 Tag="One debrief line — same for every round"
                                                 Height="50"/>
                                    </StackPanel>
                                </Border>

                                <!-- ══ Steps 3–4 output — Stories & scenarios ════════════ -->
                                <Border Background="#1C2333" CornerRadius="4"
                                        Padding="10,8,10,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PiGroupHeader}">
                                            <Run Text="After steps 3–4 — Stories &amp; scenarios"/>
                                            <Run Text="  (one per ingest; click again to append)" Foreground="#7A7A7A" FontWeight="Normal"/>
                                        </TextBlock>
                                        <TextBlock Text="PROJECT STORIES" Style="{StaticResource PiLabel}"/>
                                        <TextBox x:Name="PiProjectStories"
                                                 Style="{StaticResource DarkInput}"
                                                 Tag="Step 3 adds one story — run again for a second"
                                                 Height="120"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="SYSTEM DESIGN SCENARIOS" Style="{StaticResource PiLabel}"/>
                                        <TextBox x:Name="PiSystemDesignScenarios"
                                                 Style="{StaticResource DarkInput}"
                                                 Tag="Step 4 adds one scenario — run again for a second"
                                                 Height="120"/>
                                    </StackPanel>
                                </Border>

                                <!-- ══ Tracking ════════════════════════════════════════ -->
                                <Border Background="#1C2333" CornerRadius="4"
                                        Padding="10,8,10,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Basis &amp; status"
                                                   Style="{StaticResource PiGroupHeader}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="USED FOR" Style="{StaticResource PiLabel}"/>
                                                <TextBox x:Name="PiUsedFor"
                                                         Style="{StaticResource DarkInput}"
                                                         Tag="company name"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="OUTCOME" Style="{StaticResource PiLabel}"/>
                                                <TextBox x:Name="PiOutcome"
                                                         Style="{StaticResource DarkInput}"
                                                         Text="pending"
                                                         Tag="pending / got offer / rejected"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ── Prompt mode toggle + Send button ── -->
                                <DockPanel LastChildFill="True">
                                    <ToggleButton x:Name="PromptModeToggle"
                                                  Content="Full"
                                                  Width="96" Height="34"
                                                  DockPanel.Dock="Left"
                                                  Margin="0,0,6,0"
                                                  Foreground="#9A9A9A"
                                                  Background="Transparent"
                                                  BorderBrush="#555555"
                                                  BorderThickness="1"
                                                  FontSize="12"
                                                  ToolTip="Full: uses Prompt.txt with all pre-interview fields.&#x0A;Individual: uses the round-specific prompt from Individual Prompt V2/."
                                                  Checked="PromptModeToggle_Changed"
                                                  Unchecked="PromptModeToggle_Changed"/>
                                    <Button x:Name="PiSendButton"
                                            Content="Send"
                                            Height="34"
                                            Click="PiSendButton_Click"/>
                                </DockPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ Settings tab ══ -->
                    <TabItem Header="Settings"
                             Style="{StaticResource DarkTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,10,12,16">

                                <Border Background="#1C2333" CornerRadius="4"
                                        Padding="10,8,10,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Proxy"
                                                   Style="{StaticResource PiGroupHeader}"/>
                                        <TextBlock Text="Route the embedded browser through an HTTP proxy to keep a fixed egress IP."
                                                   Foreground="#9A9A9A"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>

                                        <CheckBox x:Name="ProxyEnabledCheckBox"
                                                  Content="Enable proxy"
                                                  Foreground="#EAEAEA"
                                                  IsChecked="True"
                                                  Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Proxy IP / Host" Style="{StaticResource PiLabel}"/>
                                                <TextBox x:Name="ProxyHostTextBox"
                                                         Style="{StaticResource DarkInput}"
                                                         Tag="e.g. 45.80.96.62"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Port" Style="{StaticResource PiLabel}"/>
                                                <TextBox x:Name="ProxyPortTextBox"
                                                         Style="{StaticResource DarkInput}"
                                                         Tag="e.g. 29842"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Type" Style="{StaticResource PiLabel}"/>
                                                <ComboBox x:Name="ProxySchemeComboBox"
                                                          Height="32"
                                                          SelectedIndex="0">
                                                    <ComboBoxItem Content="HTTP"/>
                                                    <ComboBoxItem Content="HTTPS"/>
                                                    <ComboBoxItem Content="SOCKS4"/>
                                                    <ComboBoxItem Content="SOCKS5"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Bypass list (semicolon-separated)" Style="{StaticResource PiLabel}"/>
                                        <TextBox x:Name="ProxyBypassTextBox"
                                                 Style="{StaticResource DarkInput}"
                                                 Tag="localhost;127.0.0.1;&lt;local&gt;"
                                                 Height="50"
                                                 Margin="0,0,0,10"/>

                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="ProxySaveButton"
                                                    Content="Save"
                                                    Width="100" Height="32"
                                                    Margin="0,0,8,0"
                                                    Click="ProxySaveButton_Click"
                                                    ToolTip="Save proxy settings to disk."/>
                                            <Button x:Name="ProxyApplyButton"
                                                    Content="Save &amp; Restart App"
                                                    Height="32"
                                                    Click="ProxyApplyButton_Click"
                                                    ToolTip="Save proxy settings and restart the app so WebView2 picks up the new proxy."/>
                                        </StackPanel>

                                        <TextBlock x:Name="ProxySettingsStatusLabel"
                                                   Text=""
                                                   Foreground="#9A9A9A"
                                                   FontSize="11"
                                                   Margin="0,10,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>

                <!-- Send status (shared across tabs) -->
                <TextBlock x:Name="GptSendStatusLabel"
                           Grid.Row="3"
                           Text=""
                           Foreground="#9A9A9A"
                           FontSize="11"
                           Margin="2,6,2,0"
                           TextWrapping="Wrap"/>

                <!-- Capture controls -->
                <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="False">

                    <!-- Start / Stop / Clear (right side) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="StartButton"
                                Content="Start"
                                Width="90" Height="32"
                                Margin="0,0,8,0"
                                Click="StartButton_Click"/>
                        <Button x:Name="StopButton"
                                Content="Stop"
                                Width="90" Height="32"
                                Margin="0,0,8,0"
                                IsEnabled="False"
                                Click="StopButton_Click"/>
                        <Button x:Name="ClearButton"
                                Content="Clear"
                                Width="90" Height="32"
                                Click="ClearButton_Click"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
