<Window x:Class="LiveCaptionViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Live Caption Viewer"
        Icon="Assets/AppIcon.ico"
        Height="780" Width="1320"
        MinHeight="500" MinWidth="900"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Topmost="True"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <!--
        UI is built on WPF-UI (Fluent). The window itself stays a plain transparent Window
        (not FluentWindow): the app is a see-through overlay (opacity slider, click-through,
        layered WebView2), which Mica/Acrylic backdrops cannot coexist with.
        All colours come from the WPF-UI theme brushes so the whole app follows one palette.
    -->
    <Window.Resources>

        <!-- Rounded surface used for grouped content. -->
        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="14,12"/>
        </Style>

        <!-- Small rounded chip behind the opacity slider etc. -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="Padding"         Value="12,2"/>
        </Style>

        <!-- Sub-header strip inside tabs. -->
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="Padding"    Value="12,8"/>
        </Style>

        <!-- Multi-line input defaults (resume / JD / notes). Single-line fields override locally. -->
        <Style x:Key="InputBox" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="FontFamily"                  Value="Cascadia Mono, Consolas, Segoe UI"/>
            <Setter Property="FontSize"                    Value="13"/>
            <Setter Property="Padding"                     Value="10,7"/>
            <Setter Property="MinHeight"                   Value="0"/>
            <Setter Property="TextWrapping"                Value="Wrap"/>
            <Setter Property="AcceptsReturn"               Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment"    Value="Top"/>
            <Setter Property="ClearButtonEnabled"          Value="False"/>
        </Style>

        <!-- Compact tab headers so all four fit on one row in the side panel. -->
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Padding"  Value="9,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Borderless read-only text viewer (live segments). No chrome, no focus visuals. -->
        <Style x:Key="ReadOnlyView" TargetType="TextBox">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly"      Value="True"/>
            <Setter Property="TextWrapping"    Value="Wrap"/>
            <Setter Property="AcceptsReturn"   Value="True"/>
            <Setter Property="FontFamily"      Value="Cascadia Mono, Consolas, Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pre-interview field label -->
        <Style x:Key="PiLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
        </Style>

        <!-- Pre-interview group header -->
        <Style x:Key="PiGroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,8"/>
        </Style>

        <Style x:Key="PiHint" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,0,0,10"/>
        </Style>

        <!-- Interview-round pill (RadioButton) -->
        <Style x:Key="RoundPill" TargetType="RadioButton">
            <Setter Property="Foreground"      Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Background"      Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,4"/>
            <Setter Property="Margin"          Value="0,0,6,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root shell: rounded Fluent surface whose opacity is controlled by the slider -->
    <Border x:Name="AppShell"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            CornerRadius="10"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar — drag to move; opacity, click-through, minimize, close -->
        <Grid Grid.Row="0"
              x:Name="TitleBar"
              Background="Transparent"
              Margin="0,0,0,12"
              MouseDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title block -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/AppIcon.ico"
                       Width="30" Height="30"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Live Caption Viewer"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Embedded browser + Windows 11 Live Captions reader"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               FontSize="12"/>
                </StackPanel>
            </StackPanel>

            <!-- Window controls (right side) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Opacity -->
                <Border Style="{StaticResource Pill}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Eye24"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                        <Slider x:Name="OpacitySlider"
                                Width="120"
                                Minimum="0.05"
                                Maximum="1"
                                Value="1"
                                SmallChange="0.05"
                                LargeChange="0.1"
                                TickFrequency="0.05"
                                VerticalAlignment="Center"
                                ToolTip="Adjust window transparency (5% – 100%)"
                                ValueChanged="OpacitySlider_ValueChanged"/>
                        <TextBlock x:Name="OpacityLabel"
                                   Text="100%"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   Width="38"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Click-through toggle -->
                <ui:Button x:Name="ClickThroughButton"
                           Content="Pass"
                           Icon="{ui:SymbolIcon CursorClick24}"
                           Appearance="Secondary"
                           Height="32"
                           Margin="0,0,10,0"
                           ToolTip="Click-Through OFF — clicks land on this app (Ctrl+W to toggle)"
                           Click="ClickThroughButton_Click"/>

                <!-- Minimize -->
                <ui:Button Icon="{ui:SymbolIcon Subtract24}"
                           Appearance="Transparent"
                           Width="34" Height="32"
                           Padding="0"
                           Margin="0,0,2,0"
                           ToolTip="Minimize"
                           Click="MinimizeButton_Click"/>

                <!-- Close -->
                <ui:Button Icon="{ui:SymbolIcon Dismiss24}"
                           Appearance="Transparent"
                           MouseOverBackground="#C42B1C"
                           PressedBackground="#A52314"
                           Width="34" Height="32"
                           Padding="0"
                           ToolTip="Close"
                           Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main content: browser (left) | splitter | captions panel (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="380"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="1*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- ============== BROWSER COLUMN ============== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Browser toolbar -->
                <Border Grid.Row="0"
                        Style="{StaticResource GroupCard}"
                        Padding="8"
                        Margin="0,0,0,8">
                    <DockPanel LastChildFill="True">
                        <ui:Button x:Name="BackButton"
                                   DockPanel.Dock="Left"
                                   Icon="{ui:SymbolIcon ArrowLeft24}"
                                   Appearance="Transparent"
                                   Width="34" Height="32" Padding="0"
                                   ToolTip="Back"
                                   Click="BackButton_Click"/>
                        <ui:Button x:Name="ForwardButton"
                                   DockPanel.Dock="Left"
                                   Icon="{ui:SymbolIcon ArrowRight24}"
                                   Appearance="Transparent"
                                   Width="34" Height="32" Padding="0"
                                   ToolTip="Forward"
                                   Click="ForwardButton_Click"/>
                        <ui:Button x:Name="RefreshButton"
                                   DockPanel.Dock="Left"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Appearance="Transparent"
                                   Width="34" Height="32" Padding="0"
                                   Margin="0,0,8,0"
                                   ToolTip="Refresh"
                                   Click="RefreshButton_Click"/>
                        <!-- Right side: bookmarks, then Go -->
                        <ui:Button x:Name="GoButton"
                                   DockPanel.Dock="Right"
                                   Content="Go"
                                   Appearance="Primary"
                                   Height="32"
                                   MinWidth="56"
                                   Margin="8,0,0,0"
                                   Click="GoButton_Click"/>
                        <ui:Button x:Name="BookmarkGptButton"
                                   DockPanel.Dock="Right"
                                   Content="ChatGPT"
                                   Height="32"
                                   Margin="8,0,0,0"
                                   ToolTip="Navigate to ChatGPT (chatgpt.com)"
                                   Click="BookmarkGpt_Click"/>
                        <ui:Button x:Name="BookmarkClaudeButton"
                                   DockPanel.Dock="Right"
                                   Content="Claude"
                                   Height="32"
                                   Margin="8,0,0,0"
                                   ToolTip="Navigate to Claude (claude.ai)"
                                   Click="BookmarkClaude_Click"/>
                        <ui:TextBox x:Name="AddressBar"
                                    Height="32"
                                    MinHeight="0"
                                    Padding="10,5"
                                    VerticalContentAlignment="Center"
                                    PlaceholderText="Enter a URL or search…"
                                    Icon="{ui:SymbolIcon Globe24}"
                                    FontSize="13"
                                    KeyDown="AddressBar_KeyDown"/>
                    </DockPanel>
                </Border>

                <!-- Live caption bar -->
                <Border Grid.Row="1"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,0,8">
                    <DockPanel LastChildFill="True">
                        <ui:SymbolIcon DockPanel.Dock="Left"
                                       Symbol="Mic24"
                                       FontSize="14"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Top"
                                       Margin="0,1,8,0"/>
                        <ScrollViewer x:Name="LiveCaptionScroll"
                                      MaxHeight="72"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="LiveCaptionLabel"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- WebView2 surface -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="2">
                    <Grid>
                        <Grid x:Name="BrowserHost">
                            <wv2:WebView2 x:Name="Browser"/>
                        </Grid>
                        <TextBlock x:Name="BrowserOverlay"
                                   Visibility="Collapsed"
                                   Text="WebView2 unavailable."
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Padding="24"
                                   TextAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Resize splitter -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"/>

            <!-- ============== CAPTIONS COLUMN ============== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>              <!-- 0: capture status  -->
                    <RowDefinition Height="Auto"/>              <!-- 1: interview round -->
                    <RowDefinition Height="*" MinHeight="80"/>  <!-- 2: tab panel       -->
                    <RowDefinition Height="Auto"/>              <!-- 3: send status     -->
                    <RowDefinition Height="Auto"/>              <!-- 4: controls        -->
                </Grid.RowDefinitions>

                <!-- Capture status bar -->
                <Border Grid.Row="0"
                        Style="{StaticResource GroupCard}"
                        Padding="14,10"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusIndicator"
                                 Width="12" Height="12"
                                 Fill="Gray"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>
                        <TextBlock x:Name="StatusLabel"
                                   Text="Idle"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- ── Interview round selector ────────────────────────────── -->
                <Border Grid.Row="1"
                        Padding="2,2,2,0"
                        Margin="0,0,0,6">
                    <WrapPanel Orientation="Horizontal" x:Name="RoundPanel">
                        <RadioButton x:Name="RoundRecruiter"
                                     Content="Recruiter Screen"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     IsChecked="True"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundHiringManager"
                                     Content="Hiring Manager"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundTechnical"
                                     Content="Technical Screen"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundSystemDesign"
                                     Content="System Design"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundMlSystemDesign"
                                     Content="ML System Design"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundBehavioral"
                                     Content="Behavioral"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundCultureFit"
                                     Content="Culture Fit"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundPeer"
                                     Content="Peer"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundBarRaiser"
                                     Content="Bar Raiser"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundSkipLevel"
                                     Content="Skip Level"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundExecutive"
                                     Content="Executive/VP"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundFinal"
                                     Content="Final"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundPresentation"
                                     Content="Presentation"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundCaseStudy"
                                     Content="Case Study"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundResearch"
                                     Content="Research"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundCode"
                                     Content="Code"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                        <RadioButton x:Name="RoundDiagram"
                                     Content="Diagram"
                                     GroupName="InterviewRound"
                                     Style="{StaticResource RoundPill}"
                                     Checked="InterviewRound_Checked"/>
                    </WrapPanel>
                </Border>

                <!-- ── Tab panel ───────────────────────────────────────────── -->
                <TabControl x:Name="CaptionTabControl"
                            Grid.Row="2"
                            Padding="0"
                            Background="Transparent">

                    <!-- ══ SEGMENT tab ══ -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Chat24" FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Behavioral" VerticalAlignment="Center" ToolTip="Behavioral &amp; Intro"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Segment sub-header (indicator + label) -->
                            <Border Grid.Row="0"
                                    Style="{StaticResource SectionHeader}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <Ellipse x:Name="RecordingIndicator"
                                                 Width="10" Height="10"
                                                 Fill="Gray"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="SEGMENT"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RecordingLabel"
                                                   Text=" — Auto-send OFF — capture only; segment not sent (PageUp toggles)."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="PageUp = toggle Auto-send · Home/End capture (send when ON)"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1"
                                          x:Name="RecordedScroll"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="RecordedBox"
                                         Style="{StaticResource ReadOnlyView}"
                                         FontSize="14"
                                         Padding="12"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ══ Tech Interview tab ══ -->
                    <TabItem x:Name="TechInterviewTab">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Code24" FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Tech Interview" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>                    <!-- 0: SEGMENT sub-header -->
                                <RowDefinition Height="*" MinHeight="70"/>        <!-- 1: SEGMENT text       -->
                                <RowDefinition Height="Auto"/>                    <!-- 2: browser picker     -->
                                <RowDefinition Height="Auto"/>                    <!-- 3: tech status        -->
                                <RowDefinition Height="2.2*" MinHeight="140"/>    <!-- 4: screenshot         -->
                            </Grid.RowDefinitions>

                            <!-- ── SEGMENT sub-header (mirror of SEGMENT tab) ── -->
                            <Border Grid.Row="0"
                                    Style="{StaticResource SectionHeader}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <Ellipse x:Name="TiSegmentIndicator"
                                                 Width="10" Height="10"
                                                 Fill="Gray"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="SEGMENT"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TiSegmentLabel"
                                                   Text=" — Auto-send OFF — capture only; segment not sent (PageUp toggles)."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="PageUp = toggle · Home/End/Delete capture (send when ON) · Insert capture"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- ── SEGMENT text (mirror of SEGMENT tab) ── -->
                            <ScrollViewer Grid.Row="1"
                                          x:Name="TiSegmentScroll"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="TiSegmentBox"
                                         Style="{StaticResource ReadOnlyView}"
                                         FontSize="13"
                                         Padding="12,8"/>
                            </ScrollViewer>

                            <!-- ── Browser picker ── -->
                            <Border Grid.Row="2"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,6"
                                    Margin="12,8,12,8">
                                <DockPanel LastChildFill="True">
                                    <ui:Button x:Name="RefreshBrowsersButton"
                                Icon="{ui:SymbolIcon ArrowSync24}"
                                            DockPanel.Dock="Left"
                                            Content="Refresh"
                                            Width="74" Height="26"
                                            Padding="6,3"
                                            FontSize="11"
                                            Click="RefreshBrowsers_Click"/>
                                    <ui:Button x:Name="CaptureBrowserButton"
                                Appearance="Primary" Icon="{ui:SymbolIcon Camera24}"
                                            DockPanel.Dock="Right"
                                            Content="Capture"
                                            Width="100" Height="26"
                                            Padding="6,3"
                                            FontSize="11"
                                            IsEnabled="False"
                                            Margin="6,0,0,0"
                                            ToolTip="Capture selected window (global hotkey: Insert)"
                                            Click="CaptureBrowser_Click"/>
                                    <ComboBox x:Name="BrowserComboBox"
                                              Margin="8,0"
                                              VerticalAlignment="Center"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="BrowserComboBox_SelectionChanged"/>
                                </DockPanel>
                            </Border>

                            <!-- ── Tech-Interview-specific status line ── -->
                            <TextBlock x:Name="TechInterviewStatusLabel"
                                       Grid.Row="3"
                                       Text="Click Refresh to list all windows. Select one, then click Capture (or press Insert)."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="11"
                                       Margin="14,0,14,6"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- ── Captured screenshot ── -->
                            <Border Grid.Row="4"
                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="12,0,12,12">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <Image x:Name="CapturedScreenshotImage"
                                           Stretch="None"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ══ Pre-interview tab ══ -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentEdit24" FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Pre-interview" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,10,12,16">

                                <!-- ══ Ingestion pipeline ══════════════════════════════ -->
                                <Border Style="{StaticResource GroupCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Ingestion Pipeline"
                                                   Style="{StaticResource PiGroupHeader}"/>
                                        <TextBlock Style="{StaticResource PiHint}"
                                                   Text="Fill “Your inputs” below, tick the steps you want, then press Start. Steps run one after another and report progress here; you confirm each result before it is applied. Steps missing their inputs are skipped."/>

                                        <ProgressBar x:Name="PiIngestOverallProgress"
                                                     Height="4"
                                                     Minimum="0" Maximum="1" Value="0"
                                                     Margin="0,0,0,10"
                                                     BorderThickness="0"
                                                     Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                     Background="{DynamicResource ControlFillColorSecondaryBrush}"/>

                                        <!-- Progress stepper (rows are data-bound; not buttons) -->
                                        <ItemsControl x:Name="PiIngestSteps"
                                                      Margin="0,0,0,6"
                                                      Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="26"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0"
                                                                  MinWidth="0"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanEdit}"
                                                                  VerticalAlignment="Top"
                                                                  Margin="0,0,8,0"
                                                                  ToolTip="Include this step in the run"/>
                                                        <Grid Grid.Column="1"
                                                              Width="18" Height="18"
                                                              VerticalAlignment="Top"
                                                              HorizontalAlignment="Left"
                                                              Margin="0,3,0,0">
                                                            <ui:SymbolIcon Symbol="{Binding Symbol}"
                                                                           Foreground="{Binding GlyphBrush}"
                                                                           FontSize="16"
                                                                           Visibility="{Binding IconVisibility}"/>
                                                            <ui:ProgressRing IsIndeterminate="True"
                                                                             Width="16" Height="16"
                                                                             Visibility="{Binding RunningVisibility}"/>
                                                        </Grid>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Detail}"
                                                                       Foreground="{Binding DetailBrush}"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ui:Button x:Name="PiIngestStartButton"
                                Appearance="Primary" Icon="{ui:SymbolIcon Play24}" HorizontalAlignment="Stretch"
                                                Content="Start ingestion"
                                                Height="32"
                                                Margin="0,0,0,8"
                                                Click="PiIngestStartButton_Click"/>

                                        <TextBlock x:Name="PiIngestStatusLabel"
                                                   Text=""
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- ══ Your inputs (manual — before ingest) ════════════ -->
                                <Border Style="{StaticResource GroupCard}" Margin="0,0,0,10"
                                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Your inputs"
                                                   Style="{StaticResource PiGroupHeader}"/>
                                        <TextBlock Style="{StaticResource PiHint}"
                                                   Text="Resume + JD drive steps 2–4. Company + role context drive step 1. You can run any step when its minimum fields are filled."/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource PiLabel}">
                                                    <Run Text="RESUME SUMMARY"/>
                                                    <Run Text="  · required for 2–4" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontWeight="Normal"/>
                                                </TextBlock>
                                                <ui:TextBox x:Name="PiResumeSummary"
                                                         Style="{StaticResource InputBox}"
                                                         PlaceholderText="Paste resume bullets — used for JD analysis, project, and system design ingests"
                                                         Height="110"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource PiLabel}">
                                                    <Run Text="JOB DESCRIPTION"/>
                                                    <Run Text="  · required for 2–4 · recommended for 1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontWeight="Normal"/>
                                                </TextBlock>
                                                <ui:TextBox x:Name="PiJobDescription"
                                                         Style="{StaticResource InputBox}"
                                                         PlaceholderText="Paste JD — shared across ingests"
                                                         Height="110"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource PiLabel}">
                                                    <Run Text="COMPANY"/>
                                                    <Run Text="  · required for 1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontWeight="Normal"/>
                                                </TextBlock>
                                                <ui:TextBox x:Name="PiCompany"
                                                         Style="{StaticResource InputBox}"
                                                         PlaceholderText="Company name"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         VerticalContentAlignment="Center"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource PiLabel}">
                                                    <Run Text="SENIORITY"/>
                                                    <Run Text="  · for 1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontWeight="Normal"/>
                                                </TextBlock>
                                                <ui:TextBox x:Name="PiSeniority"
                                                         Style="{StaticResource InputBox}"
                                                         Text="Staff"
                                                         PlaceholderText="Staff"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         VerticalContentAlignment="Center"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Style="{StaticResource PiLabel}">
                                                    <Run Text="DOMAIN"/>
                                                    <Run Text="  · for 1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontWeight="Normal"/>
                                                </TextBlock>
                                                <ui:TextBox x:Name="PiDomain"
                                                         Style="{StaticResource InputBox}"
                                                         Text="AI/ML"
                                                         PlaceholderText="AI/ML"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         VerticalContentAlignment="Center"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="COMPANY STAGE" Style="{StaticResource PiLabel}"/>
                                                <ui:TextBox x:Name="PiCompanyStage"
                                                         Style="{StaticResource InputBox}"
                                                         PlaceholderText="Filled by ingest or type manually"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         VerticalContentAlignment="Center"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Style="{StaticResource PiLabel}">
                                            <Run Text="INTERVIEWER BACKGROUND"/>
                                            <Run Text="  · optional for 1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontWeight="Normal"/>
                                        </TextBlock>
                                        <ui:TextBox x:Name="PiInterviewerBackground"
                                                 Style="{StaticResource InputBox}"
                                                 PlaceholderText="LinkedIn / calendar names — optional for company research"
                                                 Height="32"
                                                 AcceptsReturn="False"
                                                         VerticalContentAlignment="Center"
                                                 TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Hidden"/>
                                    </StackPanel>
                                </Border>

                                <!-- ══ Step 1 output — Company Research ════════════════ -->
                                <Border Style="{StaticResource GroupCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PiGroupHeader}">
                                            <Run Text="After step 1 — Company context"/>
                                            <Run Text="  (ingest or edit)" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontWeight="Normal"/>
                                        </TextBlock>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Product" Style="{StaticResource PiLabel}"/>
                                                <ui:TextBox x:Name="PiProduct"
                                                         Style="{StaticResource InputBox}"
                                                         PlaceholderText="what they build in 1 sentence"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         VerticalContentAlignment="Center"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Team Focus" Style="{StaticResource PiLabel}"/>
                                                <ui:TextBox x:Name="PiTeamFocus"
                                                         Style="{StaticResource InputBox}"
                                                         PlaceholderText="what this specific team works on"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         VerticalContentAlignment="Center"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Known Tech Stack" Style="{StaticResource PiLabel}"/>
                                        <ui:TextBox x:Name="PiKnownTechStack"
                                                 Style="{StaticResource InputBox}"
                                                 PlaceholderText="from JD or research"
                                                 Height="50"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="Company Values" Style="{StaticResource PiLabel}"/>
                                        <ui:TextBox x:Name="PiCompanyValues"
                                                 Style="{StaticResource InputBox}"
                                                 PlaceholderText="from careers page or Glassdoor"
                                                 Height="50"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="Recent News" Style="{StaticResource PiLabel}"/>
                                        <ui:TextBox x:Name="PiRecentNews"
                                                 Style="{StaticResource InputBox}"
                                                 PlaceholderText="funding, product launch, or strategic shift"
                                                 Height="50"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="Typical Candidate Profile" Style="{StaticResource PiLabel}"/>
                                        <ui:TextBox x:Name="PiTypicalCandidateProfile"
                                                 Style="{StaticResource InputBox}"
                                                 PlaceholderText="What a typical hire looks like for this role"
                                                 Height="60"/>
                                    </StackPanel>
                                </Border>

                                <!-- ══ Step 2 output — JD Analysis ═════════════════════ -->
                                <Border Style="{StaticResource GroupCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PiGroupHeader}">
                                            <Run Text="After step 2 — JD analysis"/>
                                            <Run Text="  (ingest or edit)" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontWeight="Normal"/>
                                        </TextBlock>
                                        <TextBlock Text="Key Skills Detected" Style="{StaticResource PiLabel}"/>
                                        <ui:TextBox x:Name="PiKeySkillsDetected"
                                                 Style="{StaticResource InputBox}"
                                                 PlaceholderText="top 5 from resume"
                                                 Height="50"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="Key Projects Detected" Style="{StaticResource PiLabel}"/>
                                        <ui:TextBox x:Name="PiKeyProjectsDetected"
                                                 Style="{StaticResource InputBox}"
                                                 PlaceholderText="project names"
                                                 Height="50"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="JD Focus Areas Detected" Style="{StaticResource PiLabel}"/>
                                        <ui:TextBox x:Name="PiJdFocusAreasDetected"
                                                 Style="{StaticResource InputBox}"
                                                 PlaceholderText="top 3 requirements"
                                                 Height="50"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="My Differentiation" Style="{StaticResource PiLabel}"/>
                                        <ui:TextBox x:Name="PiMyDifferentiation"
                                                 Style="{StaticResource InputBox}"
                                                 PlaceholderText="What makes you better than the typical profile"
                                                 Height="60"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="My Through-Line" Style="{StaticResource PiLabel}"/>
                                        <ui:TextBox x:Name="PiMyThroughLine"
                                                 Style="{StaticResource InputBox}"
                                                 PlaceholderText="One debrief line — same for every round"
                                                 Height="50"/>
                                    </StackPanel>
                                </Border>

                                <!-- ══ Steps 3–4 output — Stories & scenarios ════════════ -->
                                <Border Style="{StaticResource GroupCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PiGroupHeader}">
                                            <Run Text="After steps 3–4 — Stories &amp; scenarios"/>
                                            <Run Text="  (one per ingest; click again to append)" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontWeight="Normal"/>
                                        </TextBlock>
                                        <TextBlock Text="PROJECT STORIES" Style="{StaticResource PiLabel}"/>
                                        <ui:TextBox x:Name="PiProjectStories"
                                                 Style="{StaticResource InputBox}"
                                                 PlaceholderText="Step 3 adds one story — run again for a second"
                                                 Height="120"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="SYSTEM DESIGN SCENARIOS" Style="{StaticResource PiLabel}"/>
                                        <ui:TextBox x:Name="PiSystemDesignScenarios"
                                                 Style="{StaticResource InputBox}"
                                                 PlaceholderText="Step 4 adds one scenario — run again for a second"
                                                 Height="120"/>
                                    </StackPanel>
                                </Border>

                                <!-- ══ Tracking ════════════════════════════════════════ -->
                                <Border Style="{StaticResource GroupCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Basis &amp; status"
                                                   Style="{StaticResource PiGroupHeader}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="USED FOR" Style="{StaticResource PiLabel}"/>
                                                <ui:TextBox x:Name="PiUsedFor"
                                                         Style="{StaticResource InputBox}"
                                                         PlaceholderText="company name"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         VerticalContentAlignment="Center"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="OUTCOME" Style="{StaticResource PiLabel}"/>
                                                <ui:TextBox x:Name="PiOutcome"
                                                         Style="{StaticResource InputBox}"
                                                         Text="pending"
                                                         PlaceholderText="pending / got offer / rejected"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         VerticalContentAlignment="Center"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ── Prompt mode toggle + Send button ── -->
                                <DockPanel LastChildFill="True">
                                    <ToggleButton x:Name="PromptModeToggle"
                                                  Content="Full"
                                                  Width="96" Height="34"
                                                  DockPanel.Dock="Left"
                                                  Margin="0,0,8,0"
                                                  FontSize="12"
                                                  ToolTip="Full: uses Prompt.txt with all pre-interview fields.&#x0A;Individual: uses the round-specific prompt from Individual Prompt V2/."
                                                  Checked="PromptModeToggle_Changed"
                                                  Unchecked="PromptModeToggle_Changed"/>
                                    <ui:Button x:Name="PiSendButton"
                                Appearance="Primary" Icon="{ui:SymbolIcon Send24}" HorizontalAlignment="Stretch"
                                            Content="Send"
                                            Height="34"
                                            Click="PiSendButton_Click"/>
                                </DockPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ Settings tab ══ -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,10,12,16">

                                <Border Style="{StaticResource GroupCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Proxy"
                                                   Style="{StaticResource PiGroupHeader}"/>
                                        <TextBlock Text="Route the embedded browser through an HTTP proxy to keep a fixed egress IP."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>

                                        <CheckBox x:Name="ProxyEnabledCheckBox"
                                                  Content="Enable proxy"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                  IsChecked="True"
                                                  Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Proxy IP / Host" Style="{StaticResource PiLabel}"/>
                                                <ui:TextBox x:Name="ProxyHostTextBox"
                                                         Style="{StaticResource InputBox}"
                                                         PlaceholderText="e.g. 45.80.96.62"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         VerticalContentAlignment="Center"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Port" Style="{StaticResource PiLabel}"/>
                                                <ui:TextBox x:Name="ProxyPortTextBox"
                                                         Style="{StaticResource InputBox}"
                                                         PlaceholderText="e.g. 29842"
                                                         Height="32"
                                                         AcceptsReturn="False"
                                                         VerticalContentAlignment="Center"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Hidden"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Type" Style="{StaticResource PiLabel}"/>
                                                <ComboBox x:Name="ProxySchemeComboBox"
                                                          Height="32"
                                                          SelectedIndex="0">
                                                    <ComboBoxItem Content="HTTP"/>
                                                    <ComboBoxItem Content="HTTPS"/>
                                                    <ComboBoxItem Content="SOCKS4"/>
                                                    <ComboBoxItem Content="SOCKS5"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Bypass list (semicolon-separated)" Style="{StaticResource PiLabel}"/>
                                        <ui:TextBox x:Name="ProxyBypassTextBox"
                                                 Style="{StaticResource InputBox}"
                                                 PlaceholderText="localhost;127.0.0.1;&lt;local&gt;"
                                                 Height="50"
                                                 Margin="0,0,0,10"/>

                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button x:Name="ProxySaveButton"
                                Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                                                    Content="Save"
                                                    Width="100" Height="32"
                                                    Margin="0,0,8,0"
                                                    Click="ProxySaveButton_Click"
                                                    ToolTip="Save proxy settings to disk."/>
                                            <ui:Button x:Name="ProxyApplyButton"
                                Icon="{ui:SymbolIcon ArrowClockwise24}"
                                                    Content="Save &amp; Restart App"
                                                    Height="32"
                                                    Click="ProxyApplyButton_Click"
                                                    ToolTip="Save proxy settings and restart the app so WebView2 picks up the new proxy."/>
                                        </StackPanel>

                                        <TextBlock x:Name="ProxySettingsStatusLabel"
                                                   Text=""
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11"
                                                   Margin="0,10,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>

                <!-- Send status (shared across tabs) -->
                <TextBlock x:Name="GptSendStatusLabel"
                           Grid.Row="3"
                           Text=""
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="11"
                           Margin="2,6,2,0"
                           TextWrapping="Wrap"/>

                <!-- Capture controls -->
                <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="False">

                    <!-- Start / Stop / Clear (right side) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button x:Name="StartButton"
                                Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                                Content="Start"
                                Width="90" Height="32"
                                Margin="0,0,8,0"
                                Click="StartButton_Click"/>
                        <ui:Button x:Name="StopButton"
                                Appearance="Danger" Icon="{ui:SymbolIcon Stop24}"
                                Content="Stop"
                                Width="90" Height="32"
                                Margin="0,0,8,0"
                                IsEnabled="False"
                                Click="StopButton_Click"/>
                        <ui:Button x:Name="ClearButton"
                                Icon="{ui:SymbolIcon Delete24}"
                                Content="Clear"
                                Width="90" Height="32"
                                Click="ClearButton_Click"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
