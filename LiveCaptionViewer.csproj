<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>LiveCaptionViewer</RootNamespace>
    <AssemblyName>LiveCaptionViewer</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- Icon stamped onto LiveCaptionViewer.exe (shown by Explorer / Start menu / taskbar). -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);chrome-extension\**;tests\**</DefaultItemExcludes>
    <!-- Lets the project be restored/compiled on Linux/macOS CI runners as well (no WPF runtime needed to build). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same .ico is bundled as a Resource so the running Window can load it via Icon=. -->
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Prompt.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Reminder.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Individual Prompt V2\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="pre interview prompt\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded Chromium-based browser via Microsoft Edge WebView2. -->
    <!-- AngleSharp 1.5.0+ patches GHSA-pgww-w46g-26qg (NU1902). -->
    <PackageReference Include="AngleSharp" Version="1.8.5" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- WebView2Loader must sit next to the exe; some setups fail with "Class not registered" otherwise. -->
  <Target Name="CopyWebView2Loader" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)runtimes\win-$(PlatformTarget)\native\WebView2Loader.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(OutDir)runtimes\win-$(PlatformTarget)\native\WebView2Loader.dll')" />
  </Target>

</Project>
