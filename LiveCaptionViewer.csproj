<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>LiveCaptionViewer</RootNamespace>
    <AssemblyName>LiveCaptionViewer</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- Icon stamped onto LiveCaptionViewer.exe (shown by Explorer / Start menu / taskbar). -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);chrome-extension\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same .ico is bundled as a Resource so the running Window can load it via Icon=. -->
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Prompt.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Reminder.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Individual Prompt V2\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded Chromium-based browser via Microsoft Edge WebView2. -->
    <!-- AngleSharp 1.5.0+ patches GHSA-pgww-w46g-26qg (NU1902). -->
    <PackageReference Include="AngleSharp" Version="1.5.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- System.Drawing.Bitmap / Graphics for the Tech Interview screenshot capture. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <!-- WebView2Loader must sit next to the exe; some setups fail with "Class not registered" otherwise. -->
  <Target Name="CopyWebView2Loader" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)runtimes\win-$(PlatformTarget)\native\WebView2Loader.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutDir)runtimes\win-$(PlatformTarget)\native\WebView2Loader.dll')" />
  </Target>

</Project>
