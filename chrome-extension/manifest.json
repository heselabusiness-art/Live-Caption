{
  "manifest_version": 3,
  "name": "Live Caption Assistant",
  "version": "1.3.1",
  "description": "Sidebar interview assistant. Captures Windows Live Captions and sends segments to ChatGPT or Claude.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Live Caption Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "windows",
    "scripting",
    "activeTab",
    "nativeMessaging",
    "commands"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "http://127.0.0.1:17891/*",
    "<all_urls>"
  ],
  "commands": {
    "capture-send": {
      "suggested_key": { "default": "Alt+1" },
      "description": "Home: capture segment and send (question / THEY ASKED)"
    },
    "capture-pushback": {
      "suggested_key": { "default": "Alt+2" },
      "description": "End: capture segment and send pushback"
    },
    "capture-only": {
      "suggested_key": { "default": "Alt+3" },
      "description": "PageUp: capture segment, display only"
    },
    "send-reminder": {
      "suggested_key": { "default": "Alt+4" },
      "description": "PageDown: send Reminder.txt or onboarding prompt"
    },
    "tech-capture": {
      "description": "Insert: capture selected tab screenshot and attach (assign in chrome://extensions/shortcuts)"
    },
    "tech-send": {
      "description": "Delete: capture segment and send as coding question (assign in chrome://extensions/shortcuts)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content/ai-page.js"],
      "run_at": "document_idle"
    }
  ]
}
